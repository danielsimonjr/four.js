{
  "name": "four.js-monorepo",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "bench": "node benchmarks/run-all.mjs",
    "blending:build": "vite build examples/blending",
    "build": "pnpm -r --workspace-concurrency=4 run build",
    "check-compat": "node tools/generate-compatibility.mjs --check",
    "check-docs": "node tools/check-docs.mjs",
    "check-spec": "node tools/check-spec.mjs",
    "coverage": "pnpm -r --filter \"./packages/*\" exec vitest run --coverage --config ../../vitest.coverage.config.ts",
    "docs": "typedoc",
    "example:build": "vite build examples/first-2d-scene",
    "examples:build": "pnpm example:build && pnpm first-3d-scene:build && pnpm playground:build && pnpm mechanism:build && pnpm blending:build && pnpm particles-demo:build && pnpm ui-demo:build && pnpm flagship:build && pnpm twin:build",
    "first-3d-scene:build": "vite build examples/first-3d-scene",
    "flagship:build": "vite build examples/flagship/one-scene-everything-moves",
    "format": "prettier --write .",
    "graph": "tsx tools/create-dependency-graph/create-dependency-graph.ts --root=.",
    "graph:check": "node tools/query-dependency-graph/query-dependency-graph.mjs --check-browser-safety",
    "graph:duplicates": "node tools/create-dependency-graph/check-duplicates.mjs --no-regen",
    "graph:query": "node tools/query-dependency-graph/query-dependency-graph.mjs --emit",
    "graph:test": "node --test tools/query-dependency-graph/query-dependency-graph.test.mjs",
    "lint": "eslint .",
    "mechanism:build": "vite build examples/mechanism",
    "particles-demo:build": "vite build examples/particles-demo",
    "playground:build": "vite build examples/physics-playground",
    "publish-names": "node tools/apply-publish-names.mjs",
    "publish-names:test": "node --test tools/apply-publish-names.test.mjs",
    "release:publish": ": \"${FOUR_PUBLISH_STAGING:?set it to a staging directory outside the checkout}\" && node tools/apply-publish-names.mjs --out=\"$FOUR_PUBLISH_STAGING\" && for dir in \"$FOUR_PUBLISH_STAGING\"/*/; do npm publish \"$dir\" --access public || exit 1; done",
    "release:version": "changeset version",
    "size": "size-limit",
    "test": "pnpm -r --workspace-concurrency=4 run test",
    "test:browser": "playwright test",
    "test:suites": "vitest run --config vitest.suites.config.ts --passWithNoTests",
    "twin:build": "vite build examples/flagship/motor-digital-twin",
    "typecheck:examples": "tsc --noEmit -p examples",
    "typecheck:tests": "tsc --noEmit -p tests",
    "ui-demo:build": "vite build examples/ui-demo"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@four/animation": "workspace:*",
    "@four/assets": "workspace:*",
    "@four/core": "workspace:*",
    "@four/diagnostics": "workspace:*",
    "@four/geometry": "workspace:*",
    "@four/input": "workspace:*",
    "@four/materials": "workspace:*",
    "@four/math": "workspace:*",
    "@four/motion": "workspace:*",
    "@four/particles": "workspace:*",
    "@four/physics": "workspace:*",
    "@four/physics-box2d": "workspace:*",
    "@four/physics-rapier": "workspace:*",
    "@four/physics-soft": "workspace:*",
    "@four/render": "workspace:*",
    "@four/render-canvas": "workspace:*",
    "@four/render-svg": "workspace:*",
    "@four/render-webgl": "workspace:*",
    "@four/render-webgpu": "workspace:*",
    "@four/scene": "workspace:*",
    "@four/serialization": "workspace:*",
    "@four/text": "workspace:*",
    "@four/ui": "workspace:*",
    "@playwright/test": "1.57.0",
    "@size-limit/preset-small-lib": "13.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "four": "workspace:*",
    "js-yaml": "^4.3.0",
    "prettier": "3.9.6",
    "size-limit": "13.0.2",
    "tsx": "^4.20.6",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "3.2.7",
    "yaml": "2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "nanoid@<3.3.17": ">=3.3.17"
    }
  }
}
