{
  "name": "four.js-monorepo",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bench": "bun benchmarks/run-all.mjs",
    "blending:build": "bunx vite build examples/blending",
    "build": "bun run --filter './packages/*' --sequential build",
    "character:build": "bunx vite build examples/character-controller",
    "check-compat": "bun tools/generate-compatibility.mjs --check",
    "check-docs": "bun tools/check-docs.mjs",
    "check-spec": "bun tools/check-spec.mjs",
    "coverage": "bun tools/run-in-packages.mjs --concurrency=4 vitest run --coverage --config ../../vitest.coverage.config.ts",
    "docs": "bunx typedoc",
    "example:build": "bunx vite build examples/first-2d-scene",
    "examples:build": "bun run example:build && bun run first-3d-scene:build && bun run playground:build && bun run mechanism:build && bun run blending:build && bun run particles-demo:build && bun run ui-demo:build && bun run flagship:build && bun run twin:build && bun run character:build",
    "first-3d-scene:build": "bunx vite build examples/first-3d-scene",
    "flagship:build": "bunx vite build examples/flagship/one-scene-everything-moves",
    "format": "bunx prettier --write .",
    "graph": "bun tools/create-dependency-graph/create-dependency-graph.ts --root=.",
    "graph:check": "bun tools/query-dependency-graph/query-dependency-graph.mjs --check-browser-safety",
    "graph:duplicates": "bun tools/create-dependency-graph/check-duplicates.mjs --no-regen",
    "graph:query": "bun tools/query-dependency-graph/query-dependency-graph.mjs --emit",
    "graph:test": "node --test tools/query-dependency-graph/query-dependency-graph.test.mjs",
    "lint": "bunx eslint .",
    "mechanism:build": "bunx vite build examples/mechanism",
    "particles-demo:build": "bunx vite build examples/particles-demo",
    "playground:build": "bunx vite build examples/physics-playground",
    "publish-names": "bun tools/apply-publish-names.mjs",
    "publish-names:test": "node --test tools/apply-publish-names.test.mjs",
    "release:publish": ": \"${FOUR_PUBLISH_STAGING:?set it to a staging directory outside the checkout}\" && bun tools/apply-publish-names.mjs --out=\"$FOUR_PUBLISH_STAGING\" && for dir in \"$FOUR_PUBLISH_STAGING\"/*/; do npm publish \"$dir\" --access public || exit 1; done",
    "release:version": "bunx changeset version",
    "size": "bunx size-limit",
    "test": "bun tools/run-in-packages.mjs --concurrency=4 --script test",
    "test:browser": "bunx playwright test",
    "test:suites": "bunx vitest run --config vitest.suites.config.ts --passWithNoTests",
    "twin:build": "bunx vite build examples/flagship/motor-digital-twin",
    "typecheck:examples": "bunx tsc --noEmit -p examples",
    "typecheck:tests": "bunx tsc --noEmit -p tests",
    "ui-demo:build": "bunx vite build examples/ui-demo"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@four/animation": "workspace:*",
    "@four/assets": "workspace:*",
    "@four/core": "workspace:*",
    "@four/diagnostics": "workspace:*",
    "@four/geometry": "workspace:*",
    "@four/input": "workspace:*",
    "@four/materials": "workspace:*",
    "@four/math": "workspace:*",
    "@four/motion": "workspace:*",
    "@four/particles": "workspace:*",
    "@four/physics": "workspace:*",
    "@four/physics-box2d": "workspace:*",
    "@four/physics-rapier": "workspace:*",
    "@four/physics-soft": "workspace:*",
    "@four/render": "workspace:*",
    "@four/render-canvas": "workspace:*",
    "@four/render-svg": "workspace:*",
    "@four/render-webgl": "workspace:*",
    "@four/render-webgpu": "workspace:*",
    "@four/scene": "workspace:*",
    "@four/serialization": "workspace:*",
    "@four/text": "workspace:*",
    "@four/ui": "workspace:*",
    "@playwright/test": "1.57.0",
    "@size-limit/preset-small-lib": "13.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "four": "workspace:*",
    "js-yaml": "^4.3.0",
    "prettier": "3.9.6",
    "size-limit": "13.0.2",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "3.2.7",
    "yaml": "2.9.0"
  }
}
