    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "four": "workspace:*",
    "prettier": "3.9.6",
    "size-limit": "13.0.2",
    "turbo": "2.10.7",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "3.2.7",
    "yaml": "2.9.0"
